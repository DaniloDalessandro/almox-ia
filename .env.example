# ============================================================
# Variáveis de ambiente para deploy no Dokploy
# Configure estas variáveis na aba "Environment" do seu serviço
# ============================================================

# Chave secreta do Django — gerada para produção
SECRET_KEY=

# Modo debug — sempre False em produção
DEBUG=False

# Hosts aceitos
ALLOWED_HOSTS=*

# URL externa do seu frontend (ex: https://almox.seudominio.com)
# Sem barra no final. Para múltiplos domínios, separe com vírgula.
CORS_ALLOWED_ORIGINS=https://seu-frontend.com

# Mesma URL do frontend — necessário para CSRF
# Para múltiplos domínios, separe com vírgula.
CSRF_TRUSTED_ORIGINS=https://seu-frontend.com
