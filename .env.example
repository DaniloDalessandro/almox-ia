# ============================================================
# Variáveis de ambiente para deploy no Dokploy
# Configure na aba "Environment" do serviço
# ============================================================

# Chave secreta do Django (obrigatória)
SECRET_KEY=

# Opcional: para restringir CORS a um domínio específico
# Deixe em branco ou * para permitir qualquer origem (sem domínio)
# CORS_ALLOWED_ORIGINS=https://meudominio.com
# CSRF_TRUSTED_ORIGINS=https://meudominio.com
