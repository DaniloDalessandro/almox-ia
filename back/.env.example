# ============================================================
# CONFIGURAÇÕES DO BACKEND - Django
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# ------------------------------------------------------------
# Django Core
# ------------------------------------------------------------

# Chave secreta do Django — NUNCA use este valor em produção!
# Gere uma nova com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-troque-esta-chave-em-producao-gere-uma-nova

# Modo debug: True em desenvolvimento, False em produção
DEBUG=True

# Hosts aceitos pelo Django (separados por vírgula)
# Em produção: coloque o domínio real, ex: meusite.com,www.meusite.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------
# CORS — Cross-Origin Resource Sharing
# Origens que têm permissão de fazer requisições à API (separadas por vírgula)
# Em produção: coloque a URL do frontend, ex: https://meusite.com
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# CSRF — Cross-Site Request Forgery
# Origens confiáveis para requisições com cookie de sessão (separadas por vírgula)
# Deve incluir o protocolo e o domínio do frontend
# ------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------
# Produção — EasyPanel (descomente e ajuste)
# ------------------------------------------------------------
# SECRET_KEY=gere-com-python-get_random_secret_key
# DEBUG=False
# ALLOWED_HOSTS=*
# CORS_ALLOWED_ORIGINS=https://seudominio.com
# CSRF_TRUSTED_ORIGINS=https://seudominio.com
